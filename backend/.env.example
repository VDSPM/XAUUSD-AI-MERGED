# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS - comma separated origins allowed to call this API (e.g. the frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgres://xauusd_app:xauusd_app_password@localhost:5432/xauusd_analysis
DATABASE_SSL=false

# Market data provider
# Supported providers: mock, oanda
MARKET_DATA_PROVIDER=oanda

# OANDA
# Never commit a real API key. Put your real credentials in backend/.env.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_INSTRUMENT=XAU_USD

# Strategy
STRATEGY_VERSION=0.1.0-foundation

# Swing detection is an engineering default (fractal lookback), not a confirmed
# strategy rule. See src/structure/swingDetector.ts for details.
STRUCTURE_SWING_LOOKBACK=2

# Decision engine score threshold (0-100) below which the decision is WAIT
# even when structure/pullback conditions are met. This is an engineering
# default pending calibration via backtesting, not a confirmed strategy rule.
DECISION_SCORE_THRESHOLD=60

# Logging
LOG_LEVEL=info
